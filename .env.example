# Copy this file to ".env" and fill in the values. ".env" is never committed.
# Never send these values in a chat. Explanation: docs/EMAIL_MELDINGEN.md

# BlackBull via cTrader Open API (phase 4+)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# E-mail alerts via a Gmail app password (phase 5)
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=

# Optional: external heartbeat (e.g. healthchecks.io) that e-mails you when the dashboard goes quiet
HEARTBEAT_URL=
